{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "--tb=short"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false
    },
    
    
    {
      "name": "Python: CLI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "hwid", "${input:command}"]
    },
    
    
    
    
  ],
  "inputs": [
    // A pickString, not a promptString: VS Code substitutes an input into a
    // single `args` element and debugpy passes it verbatim, with no shell
    // splitting — so free text can never express more than one bare token
    // ("version --help" arrives as one argument and fails). Constraining the
    // input to the subcommands this project actually renders removes the need
    // to split. Add flags by editing the `args` array directly.
    {
      "id": "command",
      "type": "pickString",
      "options": ["version", "info"],
      "default": "version",
      "description": "The hwid command to debug"
    }
  ]
}
